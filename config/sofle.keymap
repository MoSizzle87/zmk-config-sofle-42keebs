#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define SYS  3

/ {
    macros {
        raycast: raycast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPC)>;
        };
        tap_tab: tap_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp TAB>;
        };
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(EQUAL)>;
        };
        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(MINUS)>;
        };
    };

    behaviors {
        tab_raycast: tab_raycast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            bindings = <&raycast>, <&tap_tab>;
        };
        enc_zoom: enc_zoom {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&zoom_in>, <&zoom_out>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        sys_layer {
            if-layers = <NAV SYM>;
            then-layer = <SYS>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "base";
// ------------------------------------------------------------------------------------------------------------
// |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7   |  8    |  9   |   0   |  DEL  |
// |  `/~  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U   |  I    |  O   |   P   |  \/|  |
// |TAB/RCT|  A  |  S  |  D   |  F   |  G   |                   |  H   |  J   |  K    |  L   |   ;   |   '   |
// | SHIFT |  Z  |  X  |  C   |  V   |  B   | VOL↕  | SCR↕    |  N   |  M   |  ,    |  .   |   /   | CAPS  |
//               | CTRL | ALT | CMD  | NAV  | ENTER |  | SPACE | SYM  | BSPC |   -   |  =   |
            bindings = <
&kp ESC          &kp N1 &kp N2    &kp N3   &kp N4   &kp N5                        &kp N6   &kp N7   &kp N8    &kp N9    &kp N0   &kp DEL
&kp GRAVE        &kp Q  &kp W     &kp E    &kp R    &kp T                         &kp Y    &kp U    &kp I     &kp O     &kp P    &kp BSLH
&tab_raycast 0 0 &kp A  &kp S     &kp D    &kp F    &kp G                         &kp H    &kp J    &kp K     &kp L     &kp SEMI &kp SQT
&kp LSHFT        &kp Z  &kp X     &kp C    &kp V    &kp B  &kp C_MUTE  &kp C_MUTE &kp N    &kp M    &kp COMMA &kp DOT   &kp FSLH &kp CLCK
                        &kp LCTRL &kp LALT &kp LGUI &mo NAV &kp RET    &kp SPACE  &mo SYM  &kp BSPC &kp MINUS &kp EQUAL
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_SCROLL_UP C_SCROLL_DOWN>;
        };

        nav_layer {
            display-name = "nav";
// ------------------------------------------------------------------------------------------------------------
// |       |  F1  |  F2  |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
// |       | INS  | PSCR | GUI  |      |      |                   | HOME | PGDN  | PGUP  | END  |       |  F12  |
// |       |      |      |      |      |      |                   | LEFT | DOWN  |  UP   | RIGHT|       |       |
// |       | UNDO | CUT  | COPY |PASTE |      | &none | &none    |      |       |       |      |       |       |
//                |      |      |      |      |       |           |      |       |       |      |
            bindings = <
&trans &kp F1     &kp F2    &kp F3     &kp F4      &kp F5                        &kp F6   &kp F7    &kp F8    &kp F9    &kp F10 &kp F11
&trans &kp INS    &kp PSCR  &kp LGUI   &trans      &trans                        &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans  &kp F12
&trans &trans     &trans    &trans     &trans      &trans                        &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &trans  &trans
&trans &kp K_UNDO &kp K_CUT &kp K_COPY &kp K_PASTE &trans  &none     &none       &trans   &trans    &trans    &trans    &trans  &trans
                  &trans    &trans     &trans      &trans  &trans    &trans      &trans   &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &enc_zoom>;
        };

        sym_layer {
            display-name = "sym";
// ------------------------------------------------------------------------------------------------------------
// |  ~   |  !   |  @   |   #   |  $   |  %   |                   |  ^   |  &   |   *   |  (   |   )   |  |  |
// |      |      |      |       |  €   |      |                   |  {   |  }   |   [   |  ]   |       |     |
// |      |      |      |       |      |      |                   |  _   |  +   |   ;   |  :   |       |     |
// |      |      |      |       |      |      |        |  |       |      |      |       |      |       |     |
//               |      |       |      |      |        |  |       |      |      |       |      |
            bindings = <
&kp TILDE &kp EXCL &kp AT &kp HASH &kp DLLR   &kp PRCNT                 &kp CARET &kp AMPS &kp ASTRK &kp LPAR  &kp RPAR &kp PIPE
&trans    &trans   &trans &trans   &kp RA(N5) &trans                    &kp LBRC  &kp RBRC &kp LBKT  &kp RBKT  &trans   &trans
&trans    &trans   &trans &trans   &trans     &trans                    &kp UNDER &kp PLUS &kp SEMI  &kp COLON &trans   &trans
&trans    &trans   &trans &trans   &trans     &trans   &trans  &trans   &trans    &trans   &trans    &trans    &trans   &trans
                   &trans &trans   &trans     &trans   &trans  &trans   &trans    &trans   &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_SCROLL_UP C_SCROLL_DOWN>;
        };

        sys_layer {
            display-name = "sys";
// ------------------------------------------------------------------------------------------------------------
// | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5  |                |      |      |       |      |       |       |
// |       |      |      |       |       |       |                |      |      |       |      |       |       |
// |       |      |      |       |       |       |                |      |      |       |      |       |       |
// |       |      |      |       |       |       | &none |  |     |      |      |       |      |       | BOOT  |
//                |      |       |       |       |       |  |     |      |      |       |      |
            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4                &none &none &none &none &none &none
&none      &none        &none        &none        &none        &none                        &none &none &none &none &none &none
&none      &none        &none        &none        &none        &none                        &none &none &none &none &none &none
&none      &none        &none        &none        &none        &none        &none  &none     &none &none &none &none &none &bootloader
                        &none        &none        &none        &none        &none  &none     &none &none &none &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_SCROLL_UP C_SCROLL_DOWN>;
        };
    };
};
